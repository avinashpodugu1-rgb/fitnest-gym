{
  "info": {
    "name": "FitNest Gym - Locker API (ST-CSE2D-G01)",
    "description": "Run the folders top to bottom. Folder 1 holds the three twist tests from the client brief.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "lockerId",
      "value": "1"
    },
    {
      "key": "lockerId2",
      "value": "2"
    },
    {
      "key": "memberId",
      "value": "1"
    },
    {
      "key": "memberId2",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "1. Twist tests (from the brief)",
      "item": [
        {
          "name": "Test 1 - add with floor \"Floor 1\" -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"lockerId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A-101\",\n  \"floor\": \"Floor 1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/lockers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lockers"
              ]
            }
          }
        },
        {
          "name": "Test 2 - add with floor \"Other\" -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Message lists the allowed values\", () => pm.expect(pm.response.json().error).to.include(\"Floor 1, Floor 2, Floor 3\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A-102\",\n  \"floor\": \"Other\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/lockers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lockers"
              ]
            }
          }
        },
        {
          "name": "Test 3 - update to \"Floor 2\" -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Floor is now Floor 2\", () => pm.expect(pm.response.json().floor).to.eql(\"Floor 2\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A-101\",\n  \"floor\": \"Floor 2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/lockers/{{lockerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lockers",
                "{{lockerId}}"
              ]
            },
            "description": "Run Test 1 first so {{lockerId}} is set."
          }
        }
      ]
