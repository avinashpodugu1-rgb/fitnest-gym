    {
      "name": "3. Search by query parameter",
      "item": [
        {
          "name": "Lockers by floor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Every locker is on Floor 2\", () => pm.response.json().forEach(l => pm.expect(l.floor).to.eql(\"Floor 2\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/lockers?floor=Floor 2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lockers"
              ],
              "query": [
                {
                  "key": "floor",
                  "value": "Floor 2"
                }
              ]
            }
          }
        },
